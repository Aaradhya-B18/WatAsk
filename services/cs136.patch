diff --git a/services/planner.py b/services/planner.py
index 35bb6b9..edccffe 100644
--- a/services/planner.py
+++ b/services/planner.py
@@ -4,6 +4,23 @@ MATH_FACULTY = {"CS", "MATH", "STAT", "PMATH", "AMATH", "ACTSC", "CO", "MATBUS",
 MAX_PER_TERM = 5
 MAX_NON_MATH_PER_TERM = 2
 
+# Most Waterloo courses are 0.5 units. A handful of lab/companion courses are
+# 0.25 units and don't count against the standard 5-course/term cap — students
+# take them *alongside* a normal full course load, not in place of a course.
+UNIT_OVERRIDES: dict[str, float] = {
+    "CS 136L": 0.25,
+}
+DEFAULT_UNIT = 0.5
+
+
+def course_units(code: str) -> float:
+    return UNIT_OVERRIDES.get(code, DEFAULT_UNIT)
+
+
+def counts_toward_cap(code: str) -> bool:
+    """Only full (0.5-unit) courses count against the 5-course/term slot cap."""
+    return course_units(code) >= DEFAULT_UNIT
+
 
 def generate_plan(
     program: str,
@@ -63,7 +80,11 @@ def generate_plan(
         return result
 
     def term_capacity(term: str) -> int:
-        return MAX_PER_TERM - len(grid_by_term.get(term, [])) - len(schedule[term])
+        placed_codes = list(grid_by_term.get(term, [])) + [
+            c.replace("[suggested]", "").strip() for c in schedule[term]
+        ]
+        used_slots = sum(1 for c in placed_codes if counts_toward_cap(c))
+        return MAX_PER_TERM - used_slots
 
     def prereqs_ok(code: str, term_idx: int) -> bool:
         if code not in prereqs:
@@ -89,7 +110,8 @@ def generate_plan(
             start_idx = term_index.get(target, 0)
             placed = False
             for i in range(start_idx, len(study_terms)):
-                if prereqs_ok(code, i) and term_capacity(study_terms[i]) > 0:
+                fits = not counts_toward_cap(code) or term_capacity(study_terms[i]) > 0
+                if prereqs_ok(code, i) and fits:
                     schedule[study_terms[i]].append(code)
                     placed = True
                     break
@@ -107,7 +129,8 @@ def generate_plan(
         for i in range(adv_start_idx, len(study_terms)):
             t = study_terms[i]
             non_math_reserve = 1 if non_math_left > 0 else 0
-            if prereqs_ok(code, i) and term_capacity(t) > non_math_reserve:
+            fits = not counts_toward_cap(code) or term_capacity(t) > non_math_reserve
+            if prereqs_ok(code, i) and fits:
                 schedule[t].append(code + "[suggested]")
                 break
 
