         assert "No study terms" in result
+
+
+CS_GROUPS = [
+    {
+        "name": "Core",
+        "courses": ["CS 135", "CS 136", "CS 136L", "MATH 135", "MATH 136", "MATH 137", "MATH 138"],
+        "typical": {
+            "CS 135": "1A", "MATH 135": "1A", "MATH 137": "1A",
+            "CS 136": "1B", "CS 136L": "1B", "MATH 136": "1B", "MATH 138": "1B",
+        },
+    },
+]
+
+
+class TestUnitWeightedCourses:
+    """CS 136L is a 0.25-unit companion course and should not consume one of
+    the 5 course-equivalent slots in its term."""
+
+    def test_quarter_unit_course_does_not_use_a_slot(self):
+        result = generate_plan("cs", ["1A", "1B"], [], CS_GROUPS, None, {})
+        plan = parse_plan(result)
+        assert "CS 136L" in plan["1B"]
+        full_courses_1b = [c for c in plan["1B"] if c != "CS 136L"]
+        assert len(full_courses_1b) == 5, (
+            f"1B should have 5 full-unit courses plus CS 136L, got {plan['1B']}"
+        )
+
+    def test_full_unit_term_still_capped_at_five(self):
+        result = generate_plan("cs", ["1A", "1B"], [], CS_GROUPS, None, {})
+        plan = parse_plan(result)
+        assert len(plan["1A"]) == 5
